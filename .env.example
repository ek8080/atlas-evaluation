# Copy to .env (never commit .env). Inspect AI reads provider keys from the environment.

# Provider API key: set only the one you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio; free tier available): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenRouter (open-weight models; hosts pinned in model_routes.json): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Default model in Inspect format provider/model (overridable with --model).
INSPECT_EVAL_MODEL=

# Generation and budget controls
ATLAS_TEMPERATURE=0
ATLAS_MAX_TOKENS=400
ATLAS_MAX_CONNECTIONS=5
ATLAS_MAX_RETRIES=3
ATLAS_REQUEST_TIMEOUT=60
# Hard cap on model requests per run (full run = 60).
ATLAS_MAX_REQUESTS=100
# Optional: USD price per million tokens, used to print an upper-bound cost estimate.
ATLAS_PRICE_IN_PER_MTOK=
ATLAS_PRICE_OUT_PER_MTOK=
